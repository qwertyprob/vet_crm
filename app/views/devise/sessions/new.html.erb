<main class="flex min-h-screen items-center justify-center bg-muted/40 px-4 py-12">
  <%= render RubyUI::Card.new(class: "w-full max-w-md") do %>
    <%= render RubyUI::CardHeader.new do %>
      <%= render RubyUI::CardTitle.new { "Log in" } %>
      <%= render RubyUI::CardDescription.new { "Welcome back" } %>
    <% end %>

    <%= render RubyUI::CardContent.new(class: "space-y-6") do %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6", data: { controller: "submit-alert" } }) do |f| %>
        <%= render RubyUI::Alert.new(class: "hidden", data: { submit_alert_target: "alert" }) do %>
          <%= render RubyUI::AlertTitle.new { "Signing in" } %>
          <%= render RubyUI::AlertDescription.new { "Checking your credentials..." } %>
        <% end %>

        <div class="flex flex-col gap-2">
          <%= render RubyUI::FormFieldLabel.new(for: "#{resource_name}_email") { "Email" } %>
          <%= render RubyUI::Input.new(type: :email, name: "#{resource_name}[email]", id: "#{resource_name}_email", value: resource.email, autofocus: true, autocomplete: "email", placeholder: "you@clinic.com") %>
        </div>

        <div class="flex flex-col gap-2">
          <%= render RubyUI::FormFieldLabel.new(for: "#{resource_name}_password") { "Password" } %>
          <%= render RubyUI::Input.new(type: :password, name: "#{resource_name}[password]", id: "#{resource_name}_password", autocomplete: "current-password") %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.hidden_field :remember_me, value: "0" %>
            <%= render RubyUI::Checkbox.new(name: "#{resource_name}[remember_me]", id: "#{resource_name}_remember_me", value: "1", checked: resource.remember_me) %>
            <%= render RubyUI::FormFieldLabel.new(for: "#{resource_name}_remember_me") { "Remember me" } %>
          </div>
        <% end %>

        <%= render RubyUI::Button.new(
              type: :submit,
              class: "w-full",
              data: { action: "click->submit-alert#notify" }
            ) { "Log in" } %>
      <% end %>
    <% end %>

    <%= render RubyUI::CardFooter.new(class: "justify-center text-sm") do %>
      <%= render "devise/shared/links" %>
    <% end %>
  <% end %>
</main>
